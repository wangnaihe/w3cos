#!/bin/sh
# Show the compilers shipped with the shell image.
# rustc is not in the ISO. It is packed by system/scripts/package-sdk.sh.
set -eu

echo "w3cos toolchain"
echo "  runtime:  ${W3COS_RUNTIME_LIB:-/usr/lib/w3cos/libw3cos_runtime.so}"
echo "  host:     ${W3COS_RUNTIME_HOST:-/usr/bin/w3cos-runtime-host}"
echo "  shell:    /usr/bin/w3cos-shell (dlopens the runtime)"

if [ -x /usr/bin/w3cos ]; then
    echo "  compiler: /usr/bin/w3cos (TypeScript frontend)"
else
    echo "  compiler: missing (/usr/bin/w3cos)"
fi

if [ -f /usr/lib/w3cos/libw3cos_runtime.so ]; then
    echo "  abi-file: present"
else
    echo "  abi-file: libw3cos_runtime.so is not installed"
fi

echo "  rustc:    not in this image; use the W3C OS SDK"
