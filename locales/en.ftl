chain-footnote = Refusing still writes a receipt. Nothing is signed or broadcast.
chain-read-notice = Read complete. The receipt is stored.
chain-denied-notice = Nothing was read. The receipt is stored.
chain-rpc-label = Chain endpoint
chain-rpc-placeholder = No default endpoint. Type an http or https address
chain-rpc-save = Save endpoint
chain-rpc-saved = Endpoint saved. Nothing was read.
chain-rpc-cleared = Endpoint cleared. A read will not be sent.
chain-rpc-bad = That address cannot be used. Only http or https, and there is no default endpoint.
host-no-rpc = No endpoint yet. Nothing was sent.
host-rpc-failed = The endpoint did not return a readable result. Nothing was signed.
host-bad-hash = That transaction hash is not usable. Nothing was sent.
host-balance = Balance { $wei } wei. Nothing was signed or broadcast.
host-nonce = Nonce is { $nonce }. Nothing was signed or broadcast.
host-tx = Transaction status: { $status }. Nothing was signed or broadcast.
chain-tx-ok = mined
chain-tx-fail = failed
chain-tx-pending = not mined yet
tool-wallet-sign-tx = Sign one transaction with the local key. Confirm is required. Broadcast is a later choice.
tx-sign-summary = Sign this transaction to { $preview }
tx-sign-impact = Confirming signs on this device. This step does not broadcast.
tx-field-to = To { $value }
tx-field-value = Amount { $value } wei
tx-field-nonce = Nonce { $value }
tx-field-gas-price = Gas price { $value } wei
tx-field-gas = Gas limit { $value }
tx-field-chain = Chain { $value }
tx-field-data = Data { $value }
tx-data-empty = none
host-tx-signed = Signed on this device for { $to }, amount { $value } wei. Nothing was broadcast.
host-tx-fields = Those transaction fields cannot be signed.
host-tx-raw = A signed payload cannot be submitted. Nothing was signed.
host-broadcast = Broadcast. Transaction { $hash }.
host-broadcast-held = Not broadcast. The signature stays on this device.
host-broadcast-failed = The endpoint did not accept the transaction. It was not signed again.
host-broadcast-locked = Locked. Nothing was broadcast.
broadcast-cap-title = Broadcast
broadcast-sheet-title = Send the transaction just signed
broadcast-sheet-detail = This is a separate confirm. Broadcast is what sends that signed transaction to the endpoint you typed.
broadcast-sheet-empty = No endpoint yet. Broadcast still sends nothing.
broadcast-sheet-scope = Only the transaction just signed on this device. Endpoint { $origin }.
broadcast-once = Broadcast once
broadcast-deny = Don't broadcast
broadcast-footnote = Refusing still writes a receipt. The signature stays on this device and is not sent.
broadcast-sent-notice = Broadcast. The receipt is stored.
broadcast-held-notice = Nothing was broadcast. The receipt is stored.
broadcast-locked = Unlock first. This will not broadcast.
sandbox-cap-title = Sandbox
sandbox-sheet-title = Run { $command } in the sandbox
sandbox-sheet-detail = This is a separate process. The device key and the wallet stay in this window, and the sandbox cannot read them.
sandbox-locked = Unlock first. This will not run.
sandbox-scope-none = Files and the network stay closed.
sandbox-scope-fs = This run can read files. The network stays closed.
sandbox-scope-net = This run can use the network. Files stay closed.
sandbox-scope-both = This run can read files and use the network.
sandbox-once = Run once
sandbox-deny = Don't run
sandbox-fs-off = Allow reading files
sandbox-fs-on = Stop reading files
sandbox-net-off = Allow the network
sandbox-net-on = Close the network
sandbox-footnote = Refusing still writes a receipt. A grant lasts for this run only.
sandbox-ran = It ran in the sandbox.
sandbox-empty = It ran in the sandbox. There was no output.
sandbox-denied-notice = It did not run. The refusal is stored.
sandbox-missing = That program was not found. It did not run.
sandbox-no-disk = The sandbox has no disk for that path. Nothing was read.
sandbox-failed = The sandbox did not finish. This device was not changed.
sandbox-timeout = The sandbox ran too long. The process was stopped.
passkey-did = did:key
passkey-fingerprint = Pairing fingerprint
passkey-verified = Passkey is bound to this device's did:key. The assertion was checked.
toast-passkey-ok = Assertion checked. The passkey is bound to this device's did:key.
toast-passkey-fail = The assertion did not verify. The passkey was not installed.
identity-line-passkey = { $subject } · { $state } · passkey bound to this did:key
